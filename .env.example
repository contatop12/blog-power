# Cloudflare (deploy + D1 — também configurável na UI /settings)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Dashboard (Basic Auth — obrigatório em produção)
DASHBOARD_USER=admin
DASHBOARD_PASS=

# OpenRouter (fallback se não configurado na UI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PESQUISADOR=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_REDATOR=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_EDITOR=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_REVISOR=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_PAUTEIRO=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_IMAGEM=anthropic/claude-sonnet-4-5

# Evolution API (fallback — preferir configurar na UI /settings)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_GROUP_ID=

# Criptografia (secrets + wp_app_password) — 32 bytes base64
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Provider de imagem
IMAGE_PROVIDER=openrouter

# Frontend (dev local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# CORS — origens permitidas em produção (vírgula)
ALLOWED_ORIGINS=https://publisher.seudominio.com

# Google — conta contato (Ads/Keyword Planner, GBP, Search Console da ABX). Projeto aprovado 253030348436.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Google — conta ryan (Search Console, GA4). Só leitura.
GOOGLE_DATA_CLIENT_ID=
GOOGLE_DATA_CLIENT_SECRET=
GOOGLE_DATA_REFRESH_TOKEN=
