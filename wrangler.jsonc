{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog-power",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  // Roda o Worker ao lado do D1 (primário em WNAM/San José), não no PoP do usuário.
  // Cada request faz 2+ queries em série; de GRU cada uma custava ~240 ms de ida e volta.
  "placement": {
    "region": "aws:us-west-1"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "3780611396",
    "OPENROUTER_MODEL_REDATOR": "anthropic/claude-sonnet-4-5",
    "OPENROUTER_MODEL_EDITOR": "anthropic/claude-sonnet-4-5",
    "OPENROUTER_MODEL_IMAGEM": "anthropic/claude-sonnet-4-5",
    "OPENROUTER_MODEL_PAUTEIRO": "anthropic/claude-sonnet-4-5",
    "IMAGE_PROVIDER": "workers_ai",
    "ALLOWED_ORIGINS": "https://publisher-frontend.contato-097.workers.dev,http://localhost:3000,http://127.0.0.1:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "publisher-db",
      "database_id": "190684c6-5af5-4712-8e0a-f7cc504242a1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "publisher-images"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ARTICLE_QUEUE",
        "queue": "publisher-article-jobs"
      }
    ]
  }
}
